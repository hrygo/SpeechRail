<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>SpeechRailCaptureHelper</string>
	<key>CFBundleIdentifier</key>
	<string>com.speechrail.desktop.capture-helper</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>SpeechRailCaptureHelper</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<!-- tap 是在这个进程里建的，所以授权文案也在这份 Info.plist 里给一份：
	     系统按"负责进程"取这段说明，XPC service 与宿主 App 各自都要说得清。 -->
	<key>NSAudioCaptureUsageDescription</key>
	<string>录制这台 Mac 上其他 App 正在播放的声音，用于会议助手的本机音频来源。只在你选了本机音频时才会录，原始音频不留存。</string>
	<key>XPCService</key>
	<dict>
		<key>EnvironmentVariables</key>
		<dict>
			<key>SPEECHRAIL_CAPTURE_HELPER</key>
			<string>1</string>
		</dict>
		<key>JoinExistingSession</key>
		<true/>
		<key>RunLoopType</key>
		<string>NSRunLoop</string>
	</dict>
</dict>
</plist>
