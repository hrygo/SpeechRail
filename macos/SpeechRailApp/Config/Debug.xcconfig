PRODUCT_BUNDLE_IDENTIFIER = com.speechrail.desktop
MACOSX_DEPLOYMENT_TARGET = 14.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
ARCHS = arm64
ONLY_ACTIVE_ARCH = YES
// Local development has no Team ID; Distribution re-enables Hardened Runtime.
ENABLE_HARDENED_RUNTIME = NO
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
CODE_SIGN_IDENTITY = -
CODE_SIGNING_ALLOWED = YES
CODE_SIGNING_REQUIRED = NO
SPEECHRAIL_AGENT_MACH_SERVICE = com.speechrail.desktop.control
SPEECHRAIL_AGENT_PLIST = com.speechrail.desktop.control.plist
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
