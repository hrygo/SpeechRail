# Copy to .env and replace only the documented placeholders.
# This file contains no credentials, model weights, or user audio paths.

SPEECHRAIL_SERVICE_NAME=speechrail
SPEECHRAIL_VERSION=1.5.0
SPEECHRAIL_HOST=127.0.0.1
SPEECHRAIL_PORT=8201
SPEECHRAIL_MODEL_ID=speechrail/qwen3-asr-1.7b
SPEECHRAIL_TTS_MODEL_ID=speechrail/qwen3-tts
SPEECHRAIL_TTS_VOICE_IDS=["default","warm","bright","calm"]
# Optional external local Qwen3-TTS runtime. Leave both paths unset until a separately
# authorized model activation. Requests never download or resolve model snapshots.
SPEECHRAIL_QWEN3_TTS_MODEL_DIR=/absolute/path/outside/SpeechRail/Qwen3-TTS
SPEECHRAIL_QWEN3_TTS_PYTHON=/absolute/path/to/qwen3-tts-venv/bin/python
SPEECHRAIL_TTS_ALLOW_MODEL_DOWNLOADS=false
SPEECHRAIL_TTS_SAMPLE_RATE=24000
SPEECHRAIL_TTS_CHUNK_MS=100
SPEECHRAIL_TTS_REPETITION_PENALTY=1.25
SPEECHRAIL_TTS_TEMPERATURE=0.85
SPEECHRAIL_TTS_TOP_P=0.95
SPEECHRAIL_TTS_WARMUP_ON_START=true
SPEECHRAIL_COMPATIBILITY_MODEL_IDS=["Qwen3-ASR-1.7B","qwen3-asr-1.7b","whisper-1"]

# Optional durable job metadata spool. This must be an absolute directory outside the
# repository. Leave unset to keep /v1/jobs disabled; it stores opaque references only.
SPEECHRAIL_JOB_SPOOL_DIR=/absolute/path/outside/SpeechRail/job-spool
# Idle polling interval for an explicitly injected trusted JobProcessor.
SPEECHRAIL_JOB_POLL_SECONDS=0.1

# Optional native Qwen3 streaming ASR backend for /v1/realtime.
# realtime_asr_backend is disabled|native (default disabled).
# native reuses SPEECHRAIL_QWEN3_PYTHON and SPEECHRAIL_QWEN3_MODEL_DIR; the
# work uses the MLX streaming runtime (mlx-qwen3-asr) which stays loaded between
# sessions and leases one session at a time. Streaming partials are emitted on
# flush; clients must terminate with input_audio_buffer.commit.
# SPEECHRAIL_REALTIME_ASR_BACKEND=native
# SPEECHRAIL_QWEN3_STREAMING_MODE=windowed

# Optional local speaker-diarization profile for OpenAI Realtime transcription sessions.
# Install the optional dependencies in the main SpeechRail environment first:
#   uv sync --extra dev --extra diarization
# Both snapshots remain outside the repository. The Sortformer setting is a file path;
# setting it enables online anonymous labels. CAM++ is optional and is only needed for
# bounded reconnect remaps. Preflight checks configured files and importable runtimes.
# A missing profile is safe: /health reports diarization_not_configured and
# /v1/models omits gpt-4o-transcribe-diarize until the profile is ready.
# SPEECHRAIL_DIARIZATION_MODEL_PATH=/absolute/path/outside/SpeechRail/diar_streaming_sortformer_4spk-v2.nemo
# SPEECHRAIL_DIARIZATION_EMBEDDING_MODEL_PATH=/absolute/path/outside/SpeechRail/3dspeaker_speech_campplus_sv_zh-cn_16k-common.onnx
# SPEECHRAIL_DIARIZATION_MAX_BUFFER_BYTES=8388608
# SPEECHRAIL_DIARIZATION_MAX_GROUPS=64
# SPEECHRAIL_DIARIZATION_GROUP_TTL_SECONDS=900
# SPEECHRAIL_DIARIZATION_SIMILARITY_THRESHOLD=0.8

# Keep empty for loopback-only development. Required for LAN/proxy exposure.
SPEECHRAIL_API_KEY=

# Keep false in a real deployment. When both paths below are configured, the service starts
# one worker at startup and validates the external snapshot. `true` is test-only simulation.
SPEECHRAIL_BACKEND_READY=false
SPEECHRAIL_QWEN3_MODEL_DIR=/absolute/path/outside/SpeechRail/Qwen3-ASR-1.7B
SPEECHRAIL_QWEN3_PYTHON=/absolute/path/to/qwen3-venv/bin/python
# Device and Precision (mps/float16, mps/int8, cpu/float32, cpu/int8)
SPEECHRAIL_DEVICE=mps
SPEECHRAIL_DTYPE=float16

# Worker Lifecycle & Memory Management
# worker_lazy_load: false starts workers at service launch; true delays until first request.
# worker_idle_timeout_seconds: automatically closes workers after idle seconds to free memory (0 disables).
SPEECHRAIL_WORKER_LAZY_LOAD=false
SPEECHRAIL_WORKER_IDLE_TIMEOUT_SECONDS=300
# MLX Metal memory limits (in MB):
# mlx_cache_limit_mb: limit max cached buffer pool size (default 256 MB; 0 disables).
# mlx_memory_limit_mb: process-level hard memory limit (0 for unlimited).
SPEECHRAIL_MLX_CACHE_LIMIT_MB=256
SPEECHRAIL_MLX_MEMORY_LIMIT_MB=0

# Runtime limits. Upload and realtime byte limits are enforced; max audio seconds is reserved
# until decoded-duration enforcement is implemented.
SPEECHRAIL_MAX_QUEUE_SIZE=8
SPEECHRAIL_MAX_UPLOAD_BYTES=536870912
SPEECHRAIL_MAX_AUDIO_SECONDS=3600
SPEECHRAIL_MAX_REALTIME_FRAME_BYTES=160000
SPEECHRAIL_MAX_REALTIME_BUFFER_BYTES=8388608
# Maximum unsent Realtime TTS events per connection before slow_consumer closes it.
SPEECHRAIL_REALTIME_OUTBOUND_MAX_EVENTS=8
# Resource Governor: reserve capacity for realtime ASR/TTS; batch work is FIFO within its lane.
SPEECHRAIL_RUNTIME_TOTAL_CAPACITY=4
SPEECHRAIL_REALTIME_RESERVED_CAPACITY=1
SPEECHRAIL_RUNTIME_MAX_PENDING_PER_CLASS=8
SPEECHRAIL_BATCH_AGING_SECONDS=30
SPEECHRAIL_REQUEST_TIMEOUT_SECONDS=120
