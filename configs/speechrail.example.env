# Copy to .env and replace only the documented placeholders.
# This file contains no credentials, model weights, or user audio paths.

SPEECHRAIL_SERVICE_NAME=speechrail
SPEECHRAIL_VERSION=2.4.0
SPEECHRAIL_HOST=127.0.0.1
SPEECHRAIL_PORT=8201
SPEECHRAIL_MODEL_ID=speechrail/qwen3-asr-1.7b
SPEECHRAIL_TTS_MODEL_ID=speechrail/qwen3-tts
SPEECHRAIL_TTS_VOICE_IDS=["serena","vivian","uncle_fu","dylan","eric","ryan","aiden","ono_anna","sohee"]
# Optional external local Qwen3-TTS runtime. Leave both paths unset until a separately
# authorized model activation. Requests never download or resolve model snapshots.
SPEECHRAIL_QWEN3_TTS_MODEL_DIR=/absolute/path/outside/SpeechRail/Qwen3-TTS
SPEECHRAIL_QWEN3_TTS_PYTHON=/absolute/path/to/qwen3-tts-venv/bin/python
SPEECHRAIL_TTS_ALLOW_MODEL_DOWNLOADS=false
SPEECHRAIL_TTS_SAMPLE_RATE=24000
SPEECHRAIL_TTS_CHUNK_MS=100
SPEECHRAIL_TTS_REPETITION_PENALTY=1.25
SPEECHRAIL_TTS_TEMPERATURE=0.85
SPEECHRAIL_TTS_TOP_P=0.95
SPEECHRAIL_TTS_WARMUP_ON_START=true
SPEECHRAIL_COMPATIBILITY_MODEL_IDS=["Qwen3-ASR-1.7B","qwen3-asr-1.7b","whisper-1"]

# Optional durable job metadata spool. This must be an absolute directory outside the
# repository. Leave unset to keep /v1/jobs disabled; it stores opaque references only.
SPEECHRAIL_JOB_SPOOL_DIR=/absolute/path/outside/SpeechRail/job-spool
# Idle polling interval for an explicitly injected trusted JobProcessor.
SPEECHRAIL_JOB_POLL_SECONDS=0.1

# Optional native Qwen3 streaming ASR backend for /v1/realtime.
# realtime_asr_backend is disabled|native (default disabled).
# native reuses SPEECHRAIL_QWEN3_PYTHON and SPEECHRAIL_QWEN3_MODEL_DIR; the
# work uses the MLX streaming runtime (mlx-qwen3-asr) which stays loaded between
# sessions and leases one session at a time. Streaming partials are emitted on
# flush; clients must terminate with input_audio_buffer.commit.
# SPEECHRAIL_REALTIME_ASR_BACKEND=native
# SPEECHRAIL_QWEN3_STREAMING_MODE=windowed

# Optional Silero VAD for /v1/realtime speech admission and barge-in.
# realtime_vad_engine is auto|legacy|silero (default auto). auto resolves to the
# Silero ONNX model when realtime_vad_model_path is configured, and otherwise
# falls back to the zero-dependency legacy engine. The supported Apple Silicon
# macOS 14+ application wheel includes onnxruntime==1.29.0; clients do not install
# a separate VAD SDK. Managed setup downloads the pinned Silero model when the
# network is reachable; it can also be placed manually and pointed to here. If a
# model path is configured but the runtime/model preflight fails, server_vad
# fails closed and health reports the VAD-specific diagnostic. shadow is a
# legacy-primary A/B aid and is rejected whenever the engine resolves to Silero.
# SPEECHRAIL_REALTIME_VAD_ENGINE=auto
# SPEECHRAIL_REALTIME_VAD_MODEL_PATH=/absolute/path/outside/SpeechRail/silero_vad.onnx
# SPEECHRAIL_REALTIME_VAD_SHADOW_ENABLED=false
# SPEECHRAIL_REALTIME_VAD_BARGEIN_COOLDOWN_MS=250

# Tier-scoped optional local speaker-diarization profile for OpenAI-compatible file
# transcription and the explicitly enabled Realtime extension. Required for the
# balanced/quality tiers (diarization ON); absent for light (diarization OFF, no
# aligner, no CoreML paths). Production uses exactly one FluidAudio CoreML FP16
# Swift worker. The compiled model bundle stays outside the repository; the macOS
# wheel supplies the executable. The service never downloads, compiles, changes
# precision, or falls back on a request path.
# A missing profile is safe: /health reports diarization_not_configured and
# /v1/models omits gpt-4o-transcribe-diarize until the profile is ready.
# Diarization also requires this local Qwen3 ForcedAligner snapshot (q8 for
# balanced, bf16 for quality). It is passed only to the existing private ASR
# worker; requests never download it and ordinary ASR/TTS does not initialize it.
# SPEECHRAIL_QWEN3_ALIGNER_MODEL_DIR=/absolute/path/outside/SpeechRail/Qwen3-ForcedAligner-0.6B
# SPEECHRAIL_DIARIZATION_COREML_MODEL_PATH=/absolute/path/outside/SpeechRail/SortformerNvidiaLow_v2.1.mlmodelc
# Optional override for a managed diagnostic/release worker; omit to use the wheel binary.
# SPEECHRAIL_DIARIZATION_WORKER_PATH=/absolute/path/outside/SpeechRail/SpeechRailDiarizationWorker

# Keep empty for loopback-only development. Required for LAN/proxy exposure.
SPEECHRAIL_API_KEY=

# Keep false in a real deployment. When both paths below are configured, the service starts
# one worker at startup and validates the external snapshot. `true` is test-only simulation.
SPEECHRAIL_BACKEND_READY=false
SPEECHRAIL_QWEN3_MODEL_DIR=/absolute/path/outside/SpeechRail/Qwen3-ASR-1.7B
SPEECHRAIL_QWEN3_PYTHON=/absolute/path/to/qwen3-venv/bin/python
# Device and Precision (mps/float16, mps/int8, cpu/float32, cpu/int8)
# dtype controls the load precision for a NON-pre-quantized snapshot: int8 requests
# in-memory quantization on the ASR worker only. The TTS worker never runtime-quantizes;
# it always loads float16 (mps) / float32 (cpu). A pre-quantized "-8bit" MLX snapshot
# is detected from config.json and loaded directly as int8 by both ASR and TTS — no
# dtype change is needed and no second quantization is performed.
SPEECHRAIL_DEVICE=mps
SPEECHRAIL_DTYPE=float16

# Worker Lifecycle & Memory Management
# worker_lazy_load: true delays worker start until the first request (default); false starts workers at service launch.
#   The first request after startup (or after an idle eviction) blocks briefly while the model loads.
# worker_min_uptime_seconds: minimum uptime after a fresh load before idle eviction may act (anti-thrash guard).
# worker_warm_standby_timeout_seconds: trim memory caches after this much idle time (0 disables standby).
# worker_idle_timeout_seconds: closes evictable workers after idle seconds to release resident
# references (0 disables eviction; exact physical memory reclamation is runtime-dependent).
SPEECHRAIL_WORKER_LAZY_LOAD=true
SPEECHRAIL_WORKER_MIN_UPTIME_SECONDS=60
SPEECHRAIL_WORKER_WARM_STANDBY_TIMEOUT_SECONDS=60
SPEECHRAIL_WORKER_IDLE_TIMEOUT_SECONDS=300
# MLX Metal memory limits (in MB):
# mlx_cache_limit_mb: limit max cached/reusable buffer pool size (default 256 MB; 0 disables).
# mlx_memory_limit_mb: MLX garbage-collection/cache guideline ONLY — it does NOT cap live
#    allocations. The ASR load-time peak (bf16->fp16 cast + int8 quantize transient) is
#    active memory and is NOT bound by this knob; reduce it via a pre-quantized int8
#    snapshot, or by matching Session dtype to the stored weights. (0 = unlimited.)
SPEECHRAIL_MLX_CACHE_LIMIT_MB=256
SPEECHRAIL_MLX_MEMORY_LIMIT_MB=0

# Runtime limits. Upload and realtime byte limits are enforced; max audio seconds is reserved
# until decoded-duration enforcement is implemented.
SPEECHRAIL_MAX_QUEUE_SIZE=8
SPEECHRAIL_MAX_UPLOAD_BYTES=536870912
SPEECHRAIL_MAX_AUDIO_SECONDS=3600
SPEECHRAIL_MAX_REALTIME_FRAME_BYTES=160000
SPEECHRAIL_MAX_REALTIME_BUFFER_BYTES=8388608
# Maximum concurrent realtime ASR sessions sharing one streaming worker (1-8).
SPEECHRAIL_REALTIME_MAX_SESSIONS=2
# Maximum unsent Realtime TTS events per connection before slow_consumer closes it.
SPEECHRAIL_REALTIME_OUTBOUND_MAX_EVENTS=8
# Resource Governor: reserve capacity for realtime ASR/TTS; batch work is FIFO within its lane.
SPEECHRAIL_RUNTIME_TOTAL_CAPACITY=4
SPEECHRAIL_REALTIME_RESERVED_CAPACITY=1
SPEECHRAIL_RUNTIME_MAX_PENDING_PER_CLASS=8
SPEECHRAIL_BATCH_AGING_SECONDS=30
# Heavy compute overlap (ASR || TTS). "auto" (default) decides from the declared
# resident bytes below against the hardware memory budget; "false" always
# serializes. "true" forces overlap and BYPASSES the memory budget entirely:
# use it only after measuring, or on a host with ample headroom, otherwise a
# low-memory machine can hit a Metal allocation failure/panic.
SPEECHRAIL_ALLOW_HEAVY_OVERLAP=auto
# Measured resident peak per component/worker, in bytes. 0 means unknown, so an
# enabled component stays fail-closed (serialized) under "auto". Quality may
# keep VoiceDesign and Base TTS workers resident together; its TTS value is the
# conservative peak of one worker and composition counts both workers. Every
# ENABLED component must have a non-zero value for "auto" to allow ASR || TTS
# overlap - including diarization on the balanced/quality tiers. Only set values
# you have actually measured.
SPEECHRAIL_ASR_RESIDENT_BYTES=0
SPEECHRAIL_TTS_RESIDENT_BYTES=0
SPEECHRAIL_DIARIZATION_RESIDENT_BYTES=0
SPEECHRAIL_REQUEST_TIMEOUT_SECONDS=120
