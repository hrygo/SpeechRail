{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speechrail.local/contracts/realtime-events.schema.json",
  "title": "SpeechRail current OpenAI Realtime ASR/TTS subset",
  "description": "Strict current-only wire schema. Legacy events and fields are rejected without aliases.",
  "oneOf": [
    {
      "$ref": "#/$defs/client_session_update"
    },
    {
      "$ref": "#/$defs/client_append"
    },
    {
      "$ref": "#/$defs/client_commit"
    },
    {
      "$ref": "#/$defs/client_clear"
    },
    {
      "$ref": "#/$defs/client_tts_start"
    },
    {
      "$ref": "#/$defs/client_tts_append_text"
    },
    {
      "$ref": "#/$defs/client_tts_finish_text"
    },
    {
      "$ref": "#/$defs/client_tts_cancel"
    },
    {
      "$ref": "#/$defs/server_session_created"
    },
    {
      "$ref": "#/$defs/server_session_updated"
    },
    {
      "$ref": "#/$defs/server_transcription_delta"
    },
    {
      "$ref": "#/$defs/server_transcription_completed"
    },
    {
      "$ref": "#/$defs/server_transcription_failed"
    },
    {
      "$ref": "#/$defs/server_hypothesis"
    },
    {
      "$ref": "#/$defs/server_alignment_done"
    },
    {
      "$ref": "#/$defs/server_alignment_failed"
    },
    {
      "$ref": "#/$defs/server_diarization_updated"
    },
    {
      "$ref": "#/$defs/server_diarization_done"
    },
    {
      "$ref": "#/$defs/server_diarization_failed"
    },
    {
      "$ref": "#/$defs/server_tts_started"
    },
    {
      "$ref": "#/$defs/server_tts_text_accepted"
    },
    {
      "$ref": "#/$defs/server_tts_audio_delta"
    },
    {
      "$ref": "#/$defs/server_tts_completed"
    },
    {
      "$ref": "#/$defs/server_tts_cancelled"
    },
    {
      "$ref": "#/$defs/server_tts_failed"
    },
    {
      "$ref": "#/$defs/server_error"
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sample_span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "codepoint_span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "pcm_format": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "rate"
      ],
      "properties": {
        "type": {
          "const": "audio/pcm"
        },
        "rate": {
          "const": 24000
        }
      }
    },
    "transcription_options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model"
      ],
      "properties": {
        "model": {
          "$ref": "#/$defs/registered_model"
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 24
          },
          "uniqueItems": true
        },
        "prompt": {
          "type": "string",
          "maxLength": 2000
        },
        "keywords": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "timestamp_granularities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "segment",
              "word",
              "character"
            ]
          }
        }
      }
    },
    "registered_model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {
        "pattern": "(?i)(q4|q6|design)"
      }
    },
    "endpointing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "const": "server_vad"
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "prefix_padding_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "silence_duration_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 5000
        }
      }
    },
    "alignment_options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "granularity": {
          "enum": [
            "segment",
            "word",
            "character"
          ]
        },
        "precision": {
          "enum": [
            "q8",
            "bf16"
          ]
        }
      }
    },
    "diarization_options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "speechrail_session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task"
      ],
      "properties": {
        "task": {
          "enum": [
            "conversation",
            "caption",
            "transcription",
            "render",
            "voice_design"
          ]
        },
        "tts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "alignment": {
          "$ref": "#/$defs/alignment_options"
        },
        "diarization": {
          "$ref": "#/$defs/diarization_options"
        },
        "endpointing": {
          "$ref": "#/$defs/endpointing"
        },
        "expected_asr_revision": {
          "$ref": "#/$defs/revision"
        },
        "expected_tts_revision": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "audio",
        "speechrail"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "const": "transcription"
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input"
          ],
          "properties": {
            "input": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "format",
                "transcription"
              ],
              "properties": {
                "format": {
                  "$ref": "#/$defs/pcm_format"
                },
                "transcription": {
                  "$ref": "#/$defs/transcription_options"
                },
                "turn_detection": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "const": "manual"
                    }
                  ]
                },
                "speechrail": {
                  "$ref": "#/$defs/speechrail_session"
                }
              }
            }
          }
        },
        "speechrail": {
          "$ref": "#/$defs/speechrail_session"
        }
      }
    },
    "session_update_session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "audio"
      ],
      "properties": {
        "type": {
          "const": "transcription"
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input"
          ],
          "properties": {
            "input": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "format",
                "transcription"
              ],
              "properties": {
                "format": {
                  "$ref": "#/$defs/pcm_format"
                },
                "transcription": {
                  "$ref": "#/$defs/transcription_options"
                },
                "turn_detection": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "const": "manual"
                    }
                  ]
                },
                "speechrail": {
                  "$ref": "#/$defs/speechrail_session"
                }
              }
            }
          }
        },
        "speechrail": {
          "$ref": "#/$defs/speechrail_session"
        }
      }
    },
    "client_session_update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "event_id",
        "session"
      ],
      "properties": {
        "type": {
          "const": "session.update"
        },
        "event_id": {
          "$ref": "#/$defs/identifier"
        },
        "session": {
          "$ref": "#/$defs/session_update_session"
        }
      }
    },
    "client_append": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "event_id",
        "audio"
      ],
      "properties": {
        "type": {
          "const": "input_audio_buffer.append"
        },
        "event_id": {
          "$ref": "#/$defs/identifier"
        },
        "audio": {
          "type": "string",
          "minLength": 2,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)$"
        }
      }
    },
    "client_commit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "event_id"
      ],
      "properties": {
        "type": {
          "const": "input_audio_buffer.commit"
        },
        "event_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "client_clear": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "event_id"
      ],
      "properties": {
        "type": {
          "const": "input_audio_buffer.clear"
        },
        "event_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_append_codepoints": {
          "type": "integer",
          "minimum": 1
        },
        "max_total_codepoints": {
          "type": "integer",
          "minimum": 1
        },
        "max_pending_codepoints": {
          "type": "integer",
          "minimum": 1
        },
        "max_pending_audio_bytes": {
          "type": "integer",
          "minimum": 2
        },
        "input_wait_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "utterance_wall_clock_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "slow_consumer_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "client_tts_start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "event_id",
        "request_id",
        "task",
        "voice"
      ],
      "properties": {
        "type": {
          "const": "speechrail.tts.start"
        },
        "event_id": {
          "$ref": "#/$defs/identifier"
        },
        "request_id": {
          "$ref": "#/$defs/identifier"
        },
        "task": {
          "enum": [
            "conversation",
            "render"
          ]
        },
        "voice": {
          "$ref": "#/$defs/identifier"
        },
        "voice_revision": {
          "$ref": "#/$defs/revision"
        },
        "expected_model_revision": {
          "$ref": "#/$defs/revision"
        },
        "speed": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 4
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      }
    },
    "client_tts_append_text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "event_id",
        "request_id",
        "sequence",
        "text"
      ],
      "properties": {
        "type": {
          "const": "speechrail.tts.append_text"
        },
        "event_id": {
          "$ref": "#/$defs/identifier"
        },
        "request_id": {
          "$ref": "#/$defs/identifier"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "client_tts_finish_text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "event_id",
        "request_id",
        "last_sequence"
      ],
      "properties": {
        "type": {
          "const": "speechrail.tts.finish_text"
        },
        "event_id": {
          "$ref": "#/$defs/identifier"
        },
        "request_id": {
          "$ref": "#/$defs/identifier"
        },
        "last_sequence": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "client_tts_cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "event_id",
        "request_id"
      ],
      "properties": {
        "type": {
          "const": "speechrail.tts.cancel"
        },
        "event_id": {
          "$ref": "#/$defs/identifier"
        },
        "request_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "server_base": {
      "type": "object",
      "required": [
        "type",
        "event_id",
        "session_id",
        "sequence"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "event_id": {
          "$ref": "#/$defs/identifier"
        },
        "session_id": {
          "$ref": "#/$defs/identifier"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "server_session_created": {
      "allOf": [
        {
          "$ref": "#/$defs/server_base"
        },
        {
          "properties": {
            "type": {
              "const": "session.created"
            },
            "session": {
              "$ref": "#/$defs/session"
            }
          },
          "required": [
            "session"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "server_session_updated": {
      "allOf": [
        {
          "$ref": "#/$defs/server_base"
        },
        {
          "properties": {
            "type": {
              "const": "session.updated"
            },
            "session": {
              "$ref": "#/$defs/session"
            }
          },
          "required": [
            "session"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "server_transcription_delta": {
      "allOf": [
        {
          "$ref": "#/$defs/server_base"
        },
        {
          "properties": {
            "type": {
              "const": "conversation.item.input_audio_transcription.delta"
            },
            "item_id": {
              "$ref": "#/$defs/identifier"
            },
            "content_index": {
              "const": 0
            },
            "delta": {
              "type": "string"
            }
          },
          "required": [
            "item_id",
            "content_index",
            "delta"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "server_transcription_completed": {
      "allOf": [
        {
          "$ref": "#/$defs/server_base"
        },
        {
          "properties": {
            "type": {
              "const": "conversation.item.input_audio_transcription.completed"
            },
            "item_id": {
              "$ref": "#/$defs/identifier"
            },
            "content_index": {
              "const": 0
            },
            "transcript": {
              "type": "string"
            }
          },
          "required": [
            "item_id",
            "content_index",
            "transcript"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "server_transcription_failed": {
      "allOf": [
        {
          "$ref": "#/$defs/server_base"
        },
        {
          "properties": {
            "type": {
              "const": "conversation.item.input_audio_transcription.failed"
            },
            "item_id": {
              "$ref": "#/$defs/identifier"
            },
            "content_index": {
              "const": 0
            },
            "error": {
              "$ref": "#/$defs/error_object"
            }
          },
          "required": [
            "item_id",
            "content_index",
            "error"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "server_hypothesis": {
      "allOf": [
        {
          "$ref": "#/$defs/server_base"
        },
        {
          "properties": {
            "type": {
              "const": "speechrail.transcription.hypothesis"
            },
            "task_id": {
              "$ref": "#/$defs/identifier"
            },
            "epoch": {
              "type": "integer",
              "minimum": 0
            },
            "utterance_id": {
              "$ref": "#/$defs/identifier"
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            },
            "text": {
              "type": "string"
            },
            "sample_span": {
              "$ref": "#/$defs/sample_span"
            },
            "stable_prefix_codepoints": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "task_id",
            "epoch",
            "utterance_id",
            "revision",
            "text",
            "sample_span"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "server_alignment_done": {
      "allOf": [
        {
          "$ref": "#/$defs/server_base"
        },
        {
          "properties": {
            "type": {
              "const": "speechrail.alignment.done"
            },
            "task_id": {
              "$ref": "#/$defs/identifier"
            },
            "epoch": {
              "type": "integer",
              "minimum": 0
            },
            "utterance_id": {
              "$ref": "#/$defs/identifier"
            },
            "transcript_revision": {
              "type": "integer",
              "minimum": 0
            },
            "metadata_revision": {
              "type": "integer",
              "minimum": 0
            },
            "sample_span": {
              "$ref": "#/$defs/sample_span"
            },
            "codepoint_span": {
              "$ref": "#/$defs/codepoint_span"
            },
            "units": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/alignment_unit"
              }
            }
          },
          "required": [
            "task_id",
            "epoch",
            "utterance_id",
            "transcript_revision",
            "metadata_revision",
            "sample_span",
            "codepoint_span",
            "units"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "server_alignment_failed": {
      "allOf": [
        {
          "$ref": "#/$defs/server_base"
        },
        {
          "properties": {
            "type": {
              "const": "speechrail.alignment.failed"
            },
            "task_id": {
              "$ref": "#/$defs/identifier"
            },
            "epoch": {
              "type": "integer",
              "minimum": 0
            },
            "utterance_id": {
              "$ref": "#/$defs/identifier"
            },
            "transcript_revision": {
              "type": "integer",
              "minimum": 0
            },
            "metadata_revision": {
              "type": "integer",
              "minimum": 0
            },
            "error": {
              "$ref": "#/$defs/error_object"
            }
          },
          "required": [
            "task_id",
            "epoch",
            "utterance_id",
            "transcript_revision",
            "metadata_revision",
            "error"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "alignment_unit": {
      "description": "One fixed-text unit on the session sample axis. text_start/text_end are codepoint offsets into the frozen transcript revision; granularity states which boundary the aligner actually evidenced (never phrase-split character).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_uid",
        "text_start",
        "text_end",
        "audio_start_sample",
        "audio_end_sample",
        "timing_quality",
        "granularity"
      ],
      "properties": {
        "segment_uid": {
          "$ref": "#/$defs/identifier"
        },
        "text_start": {
          "type": "integer",
          "minimum": 0
        },
        "text_end": {
          "type": "integer",
          "minimum": 0
        },
        "audio_start_sample": {
          "type": "integer",
          "minimum": 0
        },
        "audio_end_sample": {
          "type": "integer",
          "minimum": 0
        },
        "timing_quality": {
          "enum": [
            "aligned",
            "unavailable"
          ]
        },
        "granularity": {
          "enum": [
            "segment",
            "word",
            "character"
          ]
        }
      }
    },
    "speaker_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speaker",
        "sample_span"
      ],
      "properties": {
        "speaker": {
          "type": [
            "string",
            "null"
          ]
        },
        "sample_span": {
          "$ref": "#/$defs/sample_span"
        }
      }
    },
    "server_diarization_updated": {
      "allOf": [
        {
          "$ref": "#/$defs/server_base"
        },
        {
          "properties": {
            "type": {
              "const": "speechrail.diarization.updated"
            },
            "task_id": {
              "$ref": "#/$defs/identifier"
            },
            "epoch": {
              "type": "integer",
              "minimum": 0
            },
            "utterance_id": {
              "$ref": "#/$defs/identifier"
            },
            "transcript_revision": {
              "type": "integer",
              "minimum": 0
            },
            "metadata_revision": {
              "type": "integer",
              "minimum": 0
            },
            "units": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/speaker_unit"
              }
            }
          },
          "required": [
            "task_id",
            "epoch",
            "utterance_id",
            "transcript_revision",
