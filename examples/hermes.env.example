# Add these to the Hermes environment (for example ~/.hermes/.env) without changing
# the global OPENAI_BASE_URL used by chat.
STT_OPENAI_BASE_URL=http://127.0.0.1:8201/v1
STT_OPENAI_MODEL=speechrail/qwen3-asr-1.7b

# Hermes may require a non-empty SDK key even for loopback. Use a local placeholder only.
# Do not reuse a production credential in this file.
STT_OPENAI_API_KEY=local-not-used
